# Digitalize Nepal Production Environment Configuration
NODE_ENV=production
PORT=3000

# Database Connection:
# Option A (Recommended for quick VPS launch with zero database setup):
DATABASE_URL="file:./dev.db"

# Option B (If using PostgreSQL, set provider = "postgresql" in prisma/schema.prisma):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/digitalizenepal?schema=public"

# Production Secrets (Generate strong random strings for production)
JWT_SECRET="replace-with-a-very-long-random-string-for-hotel-auth"
ADMIN_JWT_SECRET="replace-with-a-very-long-random-string-for-admin-auth"

# Production App URL (e.g. https://app.digitalizenepal.com)
NEXT_PUBLIC_APP_URL="https://app.digitalizenepal.com"
