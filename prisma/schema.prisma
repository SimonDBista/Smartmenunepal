// Prisma Schema for Digitalize Nepal Multi-Tenant Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?  @default("Platform Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Hotel {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  ownerEmail   String        @unique
  passwordHash String
  phone        String?
  address      String?
  coverImage   String?
  status       String        @default("pending") // "pending" | "active" | "expired"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  menuItems       MenuItem[]
  orders          Order[]
  chatMessages    ChatMessage[]
  feedback        Feedback[]
  historicalSales HistoricalSale[]
  tables          RestaurantTable[]
  dailyRegisters  DailyRegister[]
  expenses        Expense[]
}

model MenuItem {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  category    String   // "Snacks", "Cuisine", "Drink", "Bed Room / Specials", etc.
  name        String
  price       Float
  imageUrl    String?
  description String?
  isAvailable Boolean  @default(true)
  is3dEnabled Boolean  @default(false)
  modelUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hotelId])
  @@index([category])
}

model Order {
  id            String        @id @default(cuid())
  hotelId       String
  hotel         Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableNumber   String
  customerName  String?
  customerPhone String?
  items         String        // JSON stringified: [{ id, name, price, quantity, notes }]
  totalAmount   Float
  discountAmount Float        @default(0)
  status        String        @default("received") // "received" | "in_progress" | "done" | "cancelled"
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  chatMessages  ChatMessage[]
  feedback      Feedback?

  @@index([hotelId])
  @@index([status])
  @@index([createdAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableNumber String?  // Table number (e.g. "1", "2", "Rooftop-VIP")
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender      String   // "customer" | "staff"
  message     String
  createdAt   DateTime @default(now())

  @@index([hotelId])
  @@index([hotelId, tableNumber])
  @@index([orderId])
}

model Feedback {
  id           String   @id @default(cuid())
  hotelId      String
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating       Int      // 1 to 5
  comment      String?
  customerName String?
  createdAt    DateTime @default(now())

  @@index([hotelId])
}

model HistoricalSale {
  id            String   @id @default(cuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  orderId       String?
  tableNumber   String
  customerName  String?
  customerPhone String?
  totalAmount   Float
  discountAmount Float   @default(0)
  items         String   // JSON stringified dishes
  notes         String?
  orderDate     DateTime // original order createdAt
  settledAt     DateTime @default(now())

  @@index([hotelId])
  @@index([orderDate])
  @@index([settledAt])
}

model RestaurantTable {
  id          String   @id @default(cuid())
  hotelId     String
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  tableNumber String   // e.g., "1", "2", "T-05", "Rooftop-1"
  name        String?  // e.g., "Terrace Booth", "Indoor Hall"
  capacity    Int?     @default(4)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([hotelId, tableNumber])
  @@index([hotelId])
}

model DailyRegister {
  id             String    @id @default(cuid())
  hotelId        String
  hotel          Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date           String    // YYYY-MM-DD
  openingBalance Float     @default(0)
  actualClosing  Float?
  notes          String?
  isClosed       Boolean   @default(false)
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([hotelId, date])
  @@index([hotelId])
  @@index([date])
}

model Expense {
  id            String   @id @default(cuid())
  hotelId       String
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  category      String   // "Meat & Poultry" | "Groceries & Rice" | "Staff Salaries" | "Utilities & Gas" | "Maintenance" | "Other"
  title         String
  amount        Float
  paymentMethod String   @default("cash") // "cash" | "online" | "bank"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([hotelId])
  @@index([hotelId, category])
  @@index([date])
}

